    <!-- Splash / onboarding -->
    <string name="splash_tagline">Your replies. Your rizz.</string>
    <string name="onb1_title">Replies that sound like you</string>
    <string name="onb1_body">Paste a chat, share a message or upload a screenshot. Get three natural replies in seconds, in Greek, English or Greeklish.</string>
    <string name="onb2_title">A bubble, not a new keyboard</string>
    <string name="onb2_body">Keep your Samsung Keyboard exactly as it is. MyRizz AI floats above your apps only when you turn it on.</string>
    <string name="onb3_title">You stay in control</string>
    <string name="onb3_body">Nothing is read automatically. AI runs only when you tap, and you approve every reply before it is sent.</string>
    <string name="onb_get_started">Get started</string>

    <!-- Setup -->
    <string name="setup_title">Set up</string>
    <string name="setup_overlay_title">Display over other apps</string>
    <string name="setup_overlay_body">Lets the floating bubble appear above WhatsApp, Instagram, Tinder and others. MyRizz AI never reads what is on your screen.</string>
    <string name="setup_notif_title">Notifications</string>
    <string name="setup_notif_body">Shows a small notification while the bubble is on, so you can switch it off at any time.</string>
    <string name="setup_backend_title">AI backend</string>
    <string name="setup_backend_body">Connect your own secure MyRizz backend so replies are written by a real AI. Your API key stays on the server, never in this app.</string>
    <string name="setup_grant">Grant</string>
    <string name="setup_granted">Granted</string>
    <string name="setup_configure">Configure</string>
    <string name="setup_configured">Connected</string>
    <string name="setup_howto_title">How to use it</string>
    <string name="howto_1">Open any chat app and tap the floating bubble.</string>
    <string name="howto_2">Paste the message, share it to MyRizz AI, or upload a screenshot of the chat.</string>
    <string name="howto_3">Pick a style and tap Generate to get three replies.</string>
    <string name="howto_4">Tap a reply to copy it, then paste it into the chat with your Samsung Keyboard.</string>
    <string name="setup_keyboard_note">Your Samsung Keyboard stays untouched. MyRizz AI never replaces, hooks into or monitors it.</string>
    <string name="toast_need_overlay">Allow “Display over other apps” first.</string>

