    <!-- Privacy -->
    <string name="privacy_title">Privacy &amp; data</string>
    <string name="privacy_p1">Nothing is read automatically. The bubble never looks at your screen or at other apps.</string>
    <string name="privacy_p2">AI runs only when you tap Generate or Run.</string>
    <string name="privacy_p3">Your Samsung Keyboard is never replaced, hooked or logged.</string>
    <string name="privacy_p4">Conversations are not stored unless you turn on history.</string>
    <string name="privacy_p5">Text that looks like passwords, cards or one-time codes is blocked from AI.</string>
    <string name="privacy_p6">Traffic uses HTTPS only. Your AI key lives on your server, not in this app.</string>
