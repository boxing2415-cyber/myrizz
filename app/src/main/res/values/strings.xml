    <!-- About -->
    <string name="about_title">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_body">MyRizz AI is an independent assistant that helps you write better replies. It is not affiliated with WhatsApp, Instagram, Tinder, Messenger or any other app.</string>
    <string name="about_platform_note">Android does not let apps type into other apps for you. Replies are copied for you to paste, or replaced through the text-selection menu where the app allows it. You are always the one who sends.</string>

