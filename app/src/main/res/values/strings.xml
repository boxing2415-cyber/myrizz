    <!-- Consent -->
    <string name="consent_title">Send to AI?</string>
    <string name="consent_body">To write replies, the text you provide (or a screenshot, if you choose AI vision) is sent over HTTPS to your MyRizz backend and then to the AI provider. Nothing is sent until you tap a button, and conversations are not stored by default. You can withdraw consent in Privacy &amp; data.</string>
    <string name="consent_accept">I agree</string>
    <string name="consent_decline">Not now</string>

