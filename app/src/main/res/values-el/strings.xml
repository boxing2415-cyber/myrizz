    <!-- Splash / onboarding -->
    <string name="splash_tagline">Οι απαντήσεις σου. Το στυλ σου.</string>
    <string name="onb1_title">Απαντήσεις που ακούγονται σαν εσένα</string>
    <string name="onb1_body">Επικόλλησε μια συνομιλία, μοιράσου ένα μήνυμα ή ανέβασε screenshot. Πάρε τρεις φυσικές απαντήσεις σε δευτερόλεπτα, στα ελληνικά, αγγλικά ή greeklish.</string>
    <string name="onb2_title">Μια φούσκα, όχι νέο πληκτρολόγιο</string>
    <string name="onb2_body">Κράτα το Samsung Keyboard ακριβώς όπως είναι. Το MyRizz AI εμφανίζεται πάνω από τις εφαρμογές σου μόνο όταν το ενεργοποιήσεις.</string>
    <string name="onb3_title">Ο έλεγχος είναι δικός σου</string>
    <string name="onb3_body">Τίποτα δεν διαβάζεται αυτόματα. Η AI τρέχει μόνο όταν πατήσεις κουμπί και εσύ εγκρίνεις κάθε απάντηση πριν σταλεί.</string>
    <string name="onb_get_started">Ας ξεκινήσουμε</string>

    <!-- Setup -->
    <string name="setup_title">Ρύθμιση</string>
    <string name="setup_overlay_title">Εμφάνιση πάνω από άλλες εφαρμογές</string>
    <string name="setup_overlay_body">Επιτρέπει στη φούσκα να εμφανίζεται πάνω από WhatsApp, Instagram, Tinder και άλλες εφαρμογές. Το MyRizz AI δεν διαβάζει ποτέ την οθόνη σου.</string>
    <string name="setup_notif_title">Ειδοποιήσεις</string>
    <string name="setup_notif_body">Εμφανίζει μια μικρή ειδοποίηση όσο η φούσκα είναι ενεργή, ώστε να τη σβήνεις όποτε θέλεις.</string>
    <string name="setup_backend_title">Backend AI</string>
    <string name="setup_backend_body">Σύνδεσε το δικό σου ασφαλές MyRizz backend ώστε οι απαντήσεις να γράφονται από πραγματική AI. Το κλειδί API μένει στον διακομιστή, ποτέ σε αυτή την εφαρμογή.</string>
    <string name="setup_grant">Παραχώρηση</string>
    <string name="setup_granted">Παραχωρήθηκε</string>
    <string name="setup_configure">Ρύθμιση</string>
    <string name="setup_configured">Συνδεδεμένο</string>
    <string name="setup_howto_title">Πώς το χρησιμοποιείς</string>
    <string name="howto_1">Άνοιξε οποιαδήποτε εφαρμογή συνομιλίας και πάτα τη φούσκα.</string>
    <string name="howto_2">Επικόλλησε το μήνυμα, μοιράσου το στο MyRizz AI ή ανέβασε screenshot της συνομιλίας.</string>
    <string name="howto_3">Διάλεξε στυλ και πάτα Δημιουργία για να πάρεις τρεις απαντήσεις.</string>
    <string name="howto_4">Πάτα μια απάντηση για να την αντιγράψεις και επικόλλησέ την στη συνομιλία με το Samsung Keyboard σου.</string>
    <string name="setup_keyboard_note">Το Samsung Keyboard μένει ανέπαφο. Το MyRizz AI δεν το αντικαθιστά, δεν το πειράζει και δεν το παρακολουθεί.</string>
    <string name="toast_need_overlay">Επίτρεψε πρώτα το «Εμφάνιση πάνω από άλλες εφαρμογές».</string>

