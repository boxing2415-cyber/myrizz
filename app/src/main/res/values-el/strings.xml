    <!-- Consent -->
    <string name="consent_title">Αποστολή στην AI;</string>
    <string name="consent_body">Για να γραφτούν απαντήσεις, το κείμενο που δίνεις (ή ένα screenshot, αν διαλέξεις AI vision) στέλνεται μέσω HTTPS στο MyRizz backend σου και από εκεί στον πάροχο AI. Τίποτα δεν στέλνεται μέχρι να πατήσεις κουμπί και οι συνομιλίες δεν αποθηκεύονται από προεπιλογή. Μπορείς να ανακαλέσεις τη συγκατάθεση στο Απόρρητο και δεδομένα.</string>
    <string name="consent_accept">Συμφωνώ</string>
    <string name="consent_decline">Όχι τώρα</string>

