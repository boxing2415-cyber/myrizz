    <!-- About -->
    <string name="about_title">Σχετικά</string>
    <string name="about_version">Έκδοση %1$s</string>
    <string name="about_body">Το MyRizz AI είναι ανεξάρτητος βοηθός που σε βοηθά να γράφεις καλύτερες απαντήσεις. Δεν συνδέεται με το WhatsApp, το Instagram, το Tinder, το Messenger ή άλλη εφαρμογή.</string>
    <string name="about_platform_note">Το Android δεν επιτρέπει σε εφαρμογές να πληκτρολογούν για λογαριασμό σου σε άλλες εφαρμογές. Οι απαντήσεις αντιγράφονται για να τις επικολλήσεις ή αντικαθιστούν κείμενο μέσω του μενού επιλογής κειμένου όπου το επιτρέπει η εφαρμογή. Εσύ είσαι πάντα αυτός που στέλνει.</string>

